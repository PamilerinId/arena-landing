# All optional. Everything works unset.

# GA4 measurement id. Analytics is a no-op without it — no script is loaded.
NEXT_PUBLIC_ANALYTICS_ID=

# Absolute site origin, used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://arena.ng

# WhatsApp number in international format, no +.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_X_URL=
